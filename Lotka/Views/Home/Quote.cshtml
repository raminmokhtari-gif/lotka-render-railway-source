@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model Lotka.Models.QuoteRequestModel
@{
    ViewData["Title"] = "Get a Quote | Human Specialist & Autonomous AI Estimator (AED)";
}

<!-- ─── HERO: Full-Width Quote Banner (Picture Way) with Human & AI Interactive Buttons ─── -->
<section class="lotka-fullwidth-hero position-relative">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/Get a Quote.png"
             alt="LOTKA Real-Time Freight Estimator – Human and AI Collaboration"
             class="fullwidth-hero-img" />
    </div>

    <!-- Visually hidden heading for SEO -->
    <h1 class="visually-hidden">Get a Quote – Choose Human Specialist or AI Autonomous Estimator</h1>

    <!-- ── Interactive Hotspots over the Characters in the Picture ── -->
    <!-- Left Hotspot: Human Specialist (Left Pedestal) -->
    <a href="#humanQuoteModal" 
       class="position-absolute d-none d-md-block" 
       style="left: 18%; top: 32%; width: 22%; height: 50%; z-index: 20; cursor: pointer; border-radius: 16px;" 
       data-bs-toggle="modal" 
       data-bs-target="#humanQuoteModal"
       title="Consult with Senior Human Freight Specialist"
       aria-label="Open Human Freight Specialist Quote"></a>

    <!-- Right Hotspot: AI Autonomous Engine (Right Pedestal) -->
    <a href="#aiQuoteModal" 
       class="position-absolute d-none d-md-block" 
       style="right: 18%; top: 32%; width: 22%; height: 50%; z-index: 20; cursor: pointer; border-radius: 16px;" 
       data-bs-toggle="modal" 
       data-bs-target="#aiQuoteModal"
       title="Compute Instant Autonomous AI Quote in AED"
       aria-label="Open AI Freight Estimator"></a>

    <!-- ── Center Dual Action Bar: "Human" and "AI" Buttons ── -->
    <div class="quote-action-bar">
        <!-- 1. HUMAN Button -->
        <button type="button" 
                class="btn btn-quote-choice btn-quote-human" 
                id="btnQuoteHuman" 
                data-bs-toggle="modal" 
                data-bs-target="#humanQuoteModal">
            <i class="fa-solid fa-user-tie text-info fs-5"></i>
            <div class="text-start">
                <div class="fw-bold lh-1">Human Quote</div>
                <small class="opacity-75 text-white" style="font-size: 0.72rem;">Operations Specialist</small>
            </div>
        </button>

        <!-- 2. AI Button -->
        <button type="button" 
                class="btn btn-quote-choice btn-quote-ai" 
                id="btnQuoteAi" 
                data-bs-toggle="modal" 
                data-bs-target="#aiQuoteModal">
            <i class="fa-solid fa-robot text-danger fs-5"></i>
            <div class="text-start">
                <div class="fw-bold lh-1">AI Quote</div>
                <small class="opacity-75 text-white" style="font-size: 0.72rem;">Instant AED Estimator</small>
            </div>
        </button>
    </div>
</section>

<div class="modal fade lotka-modal" id="humanQuoteModal" tabindex="-1" aria-label="Human Quote"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content bg-dark text-white p-4"><button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Close"></button><h3>Human Freight Request</h3><div class="lotka-rfq-mount" data-channel="HUMAN"></div></div></div></div>
<div class="modal fade lotka-modal" id="aiQuoteModal" tabindex="-1" aria-label="AI Quote"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content bg-dark text-white p-4"><button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Close"></button><h3>AI-Assisted Freight Request</h3><p>Requests are reviewed by our sales team. No instant rate is generated.</p><div class="lotka-rfq-mount" data-channel="AI"></div></div></div></div>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script>
window.LOTKA_TURNSTILE_SITE_KEY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["LOTKA_WEBSITE_TURNSTILE_SITE_KEY"]));
(() => {
 const fields=['first_name','last_name','company','address','city','country','mobile','telephone','email','origin','destination','commodity','cargo_ready_date'];
 const title=x=>x.replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase());
 const input=(name,type='text')=>`<label class="form-label d-block mb-2">${title(name)}<input class="form-control bg-dark text-white" name="${name}" type="${type}" maxlength="512" required></label>`;
 for(const mount of document.querySelectorAll('.lotka-rfq-mount')) {
   const channel=mount.dataset.channel;
   const form=document.createElement('form');
   form.innerHTML=`<label class="d-block mb-3">Freight service<select name="mode" class="form-select" required><option value="SEA_FCL">Sea FCL</option><option value="SEA_LCL">Sea LCL</option><option value="AIR">Air Freight</option></select></label>`+fields.map(k=>input(k,k==='email'?'email':k==='cargo_ready_date'?'date':'text')).join('')+`<div class="rfq-mode-fields"></div><label class="d-block mb-2"><input type="checkbox" name="dangerous_goods"> Dangerous goods</label><div class="rfq-dg-fields"></div><label class="d-block mb-3"><input type="checkbox" name="privacy_consent" required> I consent to LOTKA processing my information for this freight request.</label><div class="rfq-turnstile"></div><div class="rfq-result" role="status" aria-live="polite"></div><button class="btn btn-primary" type="submit">Submit Request</button>`;
   mount.append(form);
   if(window.LOTKA_TURNSTILE_SITE_KEY) {
     const mountWidget=()=>{ if(!window.turnstile){setTimeout(mountWidget,200);return;} window.turnstile.render(form.querySelector(".rfq-turnstile"),{sitekey:window.LOTKA_TURNSTILE_SITE_KEY}); };
     mountWidget();
   }
   const modeFields=form.querySelector('.rfq-mode-fields'), dgFields=form.querySelector('.rfq-dg-fields');
   const render=()=>{const mode=form.elements.mode.value;modeFields.innerHTML=mode==='SEA_FCL'?`<h5>Container details</h5>${input('packing')}${input('packages','number')}<label>Container size<select name="size" class="form-select"><option>20</option><option>40</option><option>40HQ</option></select></label><label>Container type<select name="type" class="form-select"><option>DC</option><option>HQ</option><option>REEFER</option></select></label>${input('quantity','number')}${input('weight_kg','number')}`:`<h5>Package details</h5>${['count','length_cm','width_cm','height_cm','weight_kg'].map(x=>input(x,'number')).join('')}${mode==='AIR'?`<label>Temperature control<select name="temperature_control" class="form-select"><option value="NORMAL">Normal</option><option value="REEFER">Reefer</option></select></label><div class="rfq-temperature"></div>`:''}`; const tc=form.elements.temperature_control;if(tc){const change=()=>form.querySelector('.rfq-temperature').innerHTML=tc.value==='REEFER'?input('temperature_c'):'';tc.addEventListener('change',change);change();}};
   const renderDg=()=>dgFields.innerHTML=form.elements.dangerous_goods.checked?input('un_number')+input('dg_class'):'';
   form.elements.mode.addEventListener('change',render);form.elements.dangerous_goods.addEventListener('change',renderDg);render();
   form.addEventListener('submit',async e=>{e.preventDefault();const result=form.querySelector('.rfq-result');result.textContent='Submission unavailable until secure verification is configured. No request was sent.';const siteKey=window.LOTKA_TURNSTILE_SITE_KEY;if(!siteKey||!window.turnstile){return;}const token=form.querySelector('[name="cf-turnstile-response"]')?.value;if(!token){result.textContent='Please complete verification.';return;}const data=Object.fromEntries(new FormData(form));data.channel=channel;data.privacy_consent=true;data.dangerous_goods=form.elements.dangerous_goods.checked;data.turnstile_token=token;data.website='';if(data.mode==='SEA_FCL'){data.containers=[{quantity:Number(data.quantity),size:data.size,type:data.type,weight_kg:data.weight_kg}];data.packages=Number(data.packages);}else{data.packages=[{count:Number(data.count),length_cm:data.length_cm,width_cm:data.width_cm,height_cm:data.height_cm,weight_kg:data.weight_kg}];}const key=crypto.randomUUID();try{const reply=await fetch('/api/lotka-platform/rfq',{method:'POST',headers:{'Content-Type':'application/json','X-Request-Key':key},body:JSON.stringify(data)});const body=await reply.json();result.textContent=reply.ok&&body.rfq_id?`Request received: ${body.rfq_id}`:`Request not accepted: ${body.error||reply.status}`;}catch{result.textContent='Network error. Request confirmation unavailable.';}});
 }
})();
</script>

<script>
    function handleHumanQuoteSubmit() {
        const alertBox = document.getElementById('humanFormAlert');
        alertBox.className = 'alert alert-warning d-block small';
        alertBox.textContent = 'Online quote submission is not yet connected. No request has been sent or assigned. Please contact LOTKA directly by email at info@lotka.com.';
    }

</script>

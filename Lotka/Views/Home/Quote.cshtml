@model Lotka.Models.QuoteRequestModel
@{
    ViewData["Title"] = "Get a Quote | Human Specialist & Autonomous AI Estimator (AED)";
}

<!-- ─── HERO: Full-Width Quote Banner (Picture Way) with Human & AI Interactive Buttons ─── -->
<section class="lotka-fullwidth-hero position-relative">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/Get a Quote.png"
             alt="LOTKA Real-Time Freight Estimator – Human and AI Collaboration"
             class="fullwidth-hero-img" />
    </div>

    <!-- Visually hidden heading for SEO -->
    <h1 class="visually-hidden">Get a Quote – Choose Human Specialist or AI Autonomous Estimator</h1>

    <!-- ── Interactive Hotspots over the Characters in the Picture ── -->
    <!-- Left Hotspot: Human Specialist (Left Pedestal) -->
    <a href="#humanQuoteModal" 
       class="position-absolute d-none d-md-block" 
       style="left: 18%; top: 32%; width: 22%; height: 50%; z-index: 20; cursor: pointer; border-radius: 16px;" 
       data-bs-toggle="modal" 
       data-bs-target="#humanQuoteModal"
       title="Consult with Senior Human Freight Specialist"
       aria-label="Open Human Freight Specialist Quote"></a>

    <!-- Right Hotspot: AI Autonomous Engine (Right Pedestal) -->
    <a href="#aiQuoteModal" 
       class="position-absolute d-none d-md-block" 
       style="right: 18%; top: 32%; width: 22%; height: 50%; z-index: 20; cursor: pointer; border-radius: 16px;" 
       data-bs-toggle="modal" 
       data-bs-target="#aiQuoteModal"
       title="Compute Instant Autonomous AI Quote in AED"
       aria-label="Open AI Freight Estimator"></a>

    <!-- ── Center Dual Action Bar: "Human" and "AI" Buttons ── -->
    <div class="quote-action-bar">
        <!-- 1. HUMAN Button -->
        <button type="button" 
                class="btn btn-quote-choice btn-quote-human" 
                id="btnQuoteHuman" 
                data-bs-toggle="modal" 
                data-bs-target="#humanQuoteModal">
            <i class="fa-solid fa-user-tie text-info fs-5"></i>
            <div class="text-start">
                <div class="fw-bold lh-1">Human Quote</div>
                <small class="opacity-75 text-white" style="font-size: 0.72rem;">Operations Specialist</small>
            </div>
        </button>

        <!-- 2. AI Button -->
        <button type="button" 
                class="btn btn-quote-choice btn-quote-ai" 
                id="btnQuoteAi" 
                data-bs-toggle="modal" 
                data-bs-target="#aiQuoteModal">
            <i class="fa-solid fa-robot text-danger fs-5"></i>
            <div class="text-start">
                <div class="fw-bold lh-1">AI Quote</div>
                <small class="opacity-75 text-white" style="font-size: 0.72rem;">Instant AED Estimator</small>
            </div>
        </button>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════════════
     MODAL 1: HUMAN LOGISTICS SPECIALIST QUOTE
     ══════════════════════════════════════════════════════════════ -->
<div class="modal fade lotka-modal" id="humanQuoteModal" tabindex="-1" aria-labelledby="humanModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-info border-opacity-50 shadow-2xl">
            <!-- Modal Header -->
            <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary px-2 py-1"><i class="fa-solid fa-user-tie"></i> Human Desk</span>
                    <h5 class="modal-title fw-bold text-white mb-0" id="humanModalTitle">
                        Human Freight Advisory & Bespoke Quote
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-3 p-md-4">
                <!-- Direct Contact Strip -->
                <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25 mb-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <div class="fw-bold text-white small"><i class="fa-solid fa-building-circle-check text-info me-2"></i> Dubai JAFZA One Operations Command</div>
                            <div class="text-white-50 small">Direct Line: <a href="tel:+97148818618" class="text-info text-decoration-none fw-semibold">+971 4 8818618</a> &bull; Email: <a href="mailto:quote@lotka.com" class="text-info text-decoration-none fw-semibold">quote@lotka.com</a></div>
                        </div>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2 py-1 small">
                            <i class="fa-solid fa-circle-dot me-1"></i> Coordinators Online
                        </span>
                    </div>
                </div>

                <div id="humanFormAlert" class="alert d-none small" role="alert"></div>

                <!-- Human Quote Form -->
                <form id="humanQuoteForm" onsubmit="event.preventDefault(); handleHumanQuoteSubmit();">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Full Name / Contact Person</label>
                            <input type="text" id="humanName" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Tariq Mansoor" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Company / Trading Entity</label>
                            <input type="text" id="humanCompany" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Emirates Trading LLC" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Corporate Email</label>
                            <input type="email" id="humanEmail" class="form-control bg-dark text-white border-secondary" placeholder="tariq@emirates.ae" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Phone / WhatsApp Number</label>
                            <input type="tel" id="humanPhone" class="form-control bg-dark text-white border-secondary" placeholder="+971 50 123 4567" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Port of Origin</label>
                            <input type="text" id="humanOrigin" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Jebel Ali (JAFZA), Dubai" required value="Jebel Ali Port (JAFZA)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Port of Destination</label>
                            <input type="text" id="humanDestination" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Port of Rotterdam" required value="Port of Rotterdam" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Cargo Classification</label>
                        <select id="humanCargoType" class="form-select bg-dark text-white border-secondary">
                            <option selected>General Commercial Freight (FCL / LCL)</option>
                            <option>Refrigerated / Cold-Chain Pharma & Food</option>
                            <option>Project Cargo & Breakbulk (Heavy Lift / Oversized)</option>
                            <option>Dangerous Goods (IMO / Hazmat Certified)</option>
                            <option>Diplomatic & High-Value Air Cargo</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-white-50 small">Specific Requirements & Remarks</label>
                        <textarea id="humanNotes" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Provide estimated container count, tonnage, or required loading date..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="humanSubmitBtn" class="btn btn-primary px-4 fw-semibold">
                            <i class="fa-solid fa-paper-plane me-1"></i> Assign to Senior Specialist
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════

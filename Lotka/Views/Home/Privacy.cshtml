@{
    ViewData["Title"] = "Privacy Policy & Data Security";
}

<section class="page-header-section py-5 text-white position-relative">
    <div class="container position-relative">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb text-white-50 small mb-2">
                <li class="breadcrumb-item"><a href="/Home/Index" class="text-white-50 text-decoration-none spa-link" data-page="Index">Home</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Privacy Policy</li>
            </ol>
        </nav>
        <h1 class="display-4 fw-bold mb-3">Privacy & Data Governance</h1>
        <p class="lead text-white-50 mb-0">Compliance with UAE Federal Decree-Law No. 45/2021 on Personal Data Protection (PDPL) and international maritime logistics standards.</p>
    </div>
</section>

<section class="py-5">
    <div class="container text-white">
        <div class="p-4 p-md-5 rounded-4 bg-dark border border-secondary shadow-lg">
            <h3 class="h4 fw-bold text-white mb-3">1. Information We Collect</h3>
            <p class="text-white-50 small mb-4">
                Lotka Shipping Services LLC collects corporate logistics data necessary to fulfill multimodal carriage contracts, including bills of lading, consignee records, commercial cargo manifests, and customs declaration documentation.
            </p>

            <h3 class="h4 fw-bold text-white mb-3">2. AI Models & Data Confidentiality</h3>
            <p class="text-white-50 small mb-4">
                Our algorithmic routing engines process shipment parameters within secure, isolated enterprise enclaves. Your commercial cargo values, supplier identities, and negotiated freight tariffs are never utilized to train public machine learning systems.
            </p>

            <h3 class="h4 fw-bold text-white mb-3">3. Optional Website Analytics</h3>
            <p class="text-white-50 small mb-4">
                With your permission, LOTKA uses Google Analytics 4 to understand visits, page navigation,
                and interactions with this website. Google Analytics may process browser and device information,
                approximate location, and first-party analytics cookies. Analytics is optional and remains off
                until you select "Allow analytics." We do not intentionally send shipment details,
                contact-form contents, email addresses, or other personally identifiable information to Google Analytics.
                You can reject analytics or change your choice at any time using the button below.
                See <a href="https://policies.google.com/privacy" rel="noopener noreferrer" target="_blank">Google's Privacy Policy</a>.
            </p>
            <p class="mb-4">
                <button type="button" class="btn btn-outline-light btn-sm"
                        onclick="if (typeof window.lotkaOpenAnalyticsPreferences === 'function') window.lotkaOpenAnalyticsPreferences();">
                    Analytics preferences
                </button>
            </p>

            <h3 class="h4 fw-bold text-white mb-3">4. Regulatory Disclosures</h3>
            <p class="text-white-50 small mb-4">
                As an entity registered under Dubai JAFZA Authority, customs declarations are shared exclusively with authorized port authorities, Dubai Customs, and destination border control agencies in accordance with international safety mandates.
            </p>

            <div class="pt-3 border-top border-secondary border-opacity-50 text-white-50 small">
                Last updated: October 2026 &bull; Lotka Shipping Services LLC &bull; JAFZA One, Dubai, UAE
            </div>
        </div>
    </div>
</section>
